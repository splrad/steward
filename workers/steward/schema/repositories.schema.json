{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/workers/steward/schema/repositories.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "organization",
    "defaults",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 5
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "const": 302208797
        },
        "login": {
          "const": "splrad"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public",
        "private"
      ],
      "properties": {
        "public": {
          "$ref": "#/$defs/defaultAccess"
        },
        "private": {
          "$ref": "#/$defs/defaultAccess"
        }
      }
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "managed",
          "fullName"
        ],
        "properties": {
          "managed": {
            "type": "boolean"
          },
          "fullName": {
            "type": "string",
            "pattern": "^splrad/[A-Za-z0-9_.-]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "defaultAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed"
      ],
      "properties": {
        "managed": {
          "type": "boolean"
        }
      }
    }
  }
}
