{
  "baseline": "v1.46",
  "kind": "normative_document_examples_not_product_test_results",
  "limit": 3,
  "rules": [
    "只对完整可信且terminal、businessStartedProven的BUSINESS_FAILED按waveKey去重",
    "UNKNOWN或历史不完整时remaining=null；已知失败仍展示但不能据此派新业务",
    "当前wave终止前不计失败；其他业务wave在途时等待原生Run终止",
    "成功、等待、原生来源拒绝和只读错误不扣业务次数",
    "展示轮次为failedWaveKeys.length+1，达到3失败后不再发业务；不存可写轮次"
  ],
  "examples": [
    {
      "id": "B01",
      "scenario": "同attempt矩阵多失败",
      "evidenceComplete": true,
      "evidence": [
        {
          "waveKey": "repo:cycle:build:100:1",
          "classification": "BUSINESS_FAILED",
          "businessStartedProven": true,
          "terminal": true
        },
        {
          "waveKey": "repo:cycle:build:100:1",
          "classification": "BUSINESS_FAILED",
          "businessStartedProven": true,
          "terminal": true
        }
      ],
      "expected": {
        "knownFailedCount": 1,
        "remaining": 2,
        "unknown": false
      }
    },
    {
