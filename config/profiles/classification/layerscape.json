{
  "$schema": "../../../schema/classification-profile.schema.json", "schemaVersion": 2, "name": "layerscape",
  "semanticCatalog": { "id": "pr-semantics", "schemaVersion": 1 },
  "fileSets": {
    "docs": ["README.md", "docs/**"], "tests": ["tests/**", "**/*.Tests/**", "**/*.test.*", "**/*.spec.*"], "workflows": [".github/workflows/**"],
    "dependencies": ["Directory.Build.props", "Directory.Packages.props", "global.json", "**/*.csproj", "**/packages.lock.json"],
    "javascript": ["package.json", "package-lock.json", "**/*.js", "**/*.ts"],
    "runtime": ["src/**"], "release": ["Version.props", "tools/Publish-ReleaseAssets.ps1", "chore/Fonts.zip"],
    "automation": [".github/**", "tools/**"], "config": [".editorconfig", ".gitattributes", ".gitignore", "*.slnx", "*.props", "global.json"],
    "runtimeRelease": ["src/**", "tools/Publish-ReleaseAssets.ps1", "Directory.Build.props", "Directory.Packages.props", "global.json", "chore/Fonts.zip"],
    "runtimeExcluded": [".github/**", ".local/**", ".agents/**", ".codex/**", ".claude/**", ".vscode/**", "docs/**", "README.md", "LICENSE.txt", "Version.props", "CADFontAutoReplace.slnx", ".editorconfig", ".gitattributes", ".gitignore"],
    "installPackage": ["tools/Publish-ReleaseAssets.ps1", "chore/Fonts.zip", "Directory.Build.props", "Directory.Packages.props", "global.json"]
  },
  "commitTextSets": { "breakingMarkers": ["^[^\\n]+!:", "(^|\\n)BREAKING CHANGE:"] },
  "rules": {
    "primaryKind": [
      { "id": "documentation-only", "primaryKind": "documentation", "match": { "type": "all-files", "fileSets": ["docs"] } },
      { "id": "test-only", "primaryKind": "test", "match": { "type": "all-files", "fileSets": ["tests"] } },
      { "id": "workflow-only", "primaryKind": "workflow", "match": { "type": "all-files", "fileSets": ["workflows"] } },
      { "id": "dependency-build-only", "primaryKind": "build", "match": { "type": "all-files", "fileSets": ["dependencies", "release"] } }
    ],
    "riskFlags": [{ "id": "breaking-commit-marker", "riskFlag": "breaking-change", "match": { "type": "commit-text-any", "commitTextSets": ["breakingMarkers"] } }],
    "facets": [
      { "id": "dependency-files", "facet": "dependencies", "match": { "type": "any-file", "fileSets": ["dependencies"] } },
      { "id": "github-actions-files", "facet": "github_actions", "match": { "type": "any-file", "fileSets": ["workflows"] } },
      { "id": "javascript-files", "facet": "javascript", "match": { "type": "any-file", "fileSets": ["javascript"] } },
      { "id": "configuration-files", "facet": "config", "match": { "type": "any-file", "fileSets": ["config"] } }
    ]
  },
  "areas": [
    { "id": "area-runtime-files", "area": "area:runtime", "match": { "type": "any-file", "fileSets": ["runtime"] } },
    { "id": "area-release-files", "area": "area:release", "match": { "type": "any-file", "fileSets": ["release"] } },
    { "id": "area-workflow-files", "area": "area:workflow", "match": { "type": "any-file", "fileSets": ["workflows"] } },
    { "id": "area-automation-files", "area": "area:automation", "match": { "type": "any-file", "fileSets": ["automation"] } },
    { "id": "area-documentation-files", "area": "area:docs", "match": { "type": "any-file", "fileSets": ["docs"] } },
    { "id": "area-configuration-files", "area": "area:config", "match": { "type": "any-file", "fileSets": ["config"] } }
  ],
  "ai": { "eligiblePrimaryKinds": ["feature", "bug", "performance", "refactor", "build"], "minimumConfidence": "high" },
  "runtimeRelease": { "includeFileSets": ["runtimeRelease"], "excludeFileSets": ["runtimeExcluded"] },
  "installOrPackage": { "fileSets": ["installPackage"] },
  "releaseCategories": [
    { "id": "breaking", "title": "破坏性变更", "icon": "🚨", "matchAny": [{ "riskFlagsAny": ["breaking-change"] }], "fallback": false },
    { "id": "security", "title": "安全修复", "icon": "🔒", "matchAny": [{ "riskFlagsAny": ["security"] }], "fallback": false },
    { "id": "feature", "title": "新增功能", "icon": "✨", "matchAny": [{ "primaryKindsAny": ["feature"], "runtimeRelease": true }], "fallback": false },
    { "id": "bug", "title": "问题修复", "icon": "🛠", "matchAny": [{ "primaryKindsAny": ["bug"], "runtimeRelease": true }], "fallback": false },
    { "id": "performance", "title": "性能优化", "icon": "⚡", "matchAny": [{ "primaryKindsAny": ["performance"], "runtimeRelease": true }], "fallback": false },
    { "id": "build", "title": "安装与发布包", "icon": "📦", "matchAny": [{ "primaryKindsAny": ["build"], "installOrPackage": true }], "fallback": false },
    { "id": "runtime-other", "title": "其他插件变更", "icon": "🔌", "matchAny": [{ "primaryKindsAny": ["refactor", "test", "chore"], "areasAny": ["area:runtime"], "runtimeRelease": true }], "fallback": false },
    { "id": "fallback", "title": "其他变更", "icon": "📌", "fallback": true }
  ]
}
