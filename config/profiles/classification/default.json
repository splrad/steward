{
  "$schema": "../../../schema/classification-profile.schema.json",
  "schemaVersion": 1,
  "name": "default",
  "areas": [
    { "name": "area:source", "patterns": ["src/**", "packages/**"] },
    { "name": "area:test", "patterns": ["test/**", "tests/**", "**/*.test.*", "**/*.spec.*"] },
    { "name": "area:workflow", "patterns": [".github/workflows/**"] },
    { "name": "area:automation", "patterns": [".github/**", "scripts/**", "tools/**"] },
    { "name": "area:docs", "patterns": ["README*", "SECURITY*", "CONTRIBUTING*", "docs/**"] },
    { "name": "area:config", "patterns": [".editorconfig", ".gitattributes", ".gitignore", "*.json", "*.yml", "*.yaml", "*.props", "*.toml"] }
  ],
  "decisions": {
    "kindOrder": ["breaking-change", "security", "bug", "feature", "performance", "build", "documentation", "workflow", "chore"],
    "conventionalTypes": ["feat", "fix", "refactor", "perf", "style", "docs", "test", "build", "ci", "chore", "revert"],
    "typeToKind": { "feat": "feature", "fix": "bug", "refactor": "chore", "perf": "performance", "style": "chore", "docs": "documentation", "test": "chore", "build": "build", "ci": "workflow", "chore": "chore", "revert": "bug" },
    "breakingPatterns": ["(^|\\s)(feat|fix|refactor|perf|build)(\\([a-z0-9-]+\\))?!:", "breaking", "破坏性", "不兼容"],
    "securityPatterns": ["security", "vulnerability", "cve", "安全", "漏洞"],
    "fallbackKind": "chore"
  },
  "runtimeRelease": { "includePrefixes": [], "includeFiles": [], "excludePrefixes": [], "excludeFiles": [] },
  "installOrPackage": { "includeFiles": [] },
  "labels": {
    "public": [
      { "name": "breaking-change", "color": "b60205", "description": "存在破坏性或不兼容变更。" },
      { "name": "security", "color": "d73a4a", "description": "包含安全修复或安全加固。" },
      { "name": "feature", "color": "1d76db", "description": "新增用户可见功能。" },
      { "name": "bug", "color": "d73a4a", "description": "修复缺陷或回归。" },
      { "name": "performance", "color": "fbca04", "description": "包含性能改进。" },
      { "name": "build", "color": "fef2c0", "description": "修改构建、打包或依赖。" },
      { "name": "documentation", "color": "0075ca", "description": "只修改文档。" },
      { "name": "workflow", "color": "5319e7", "description": "修改自动化工作流。" },
      { "name": "chore", "color": "ededed", "description": "仓库维护性改动。" }
    ],
    "release": [],
    "internalPrefixes": ["area:", "kind:"]
  },
  "releaseCategories": []
}
