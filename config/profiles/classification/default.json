{
  "$schema": "../../../schema/classification-profile.schema.json", "schemaVersion": 2, "name": "default",
  "semanticCatalog": { "id": "pr-semantics", "schemaVersion": 1 },
  "fileSets": {
    "docs": ["README*", "SECURITY*", "CONTRIBUTING*", "docs/**"],
    "tests": ["test/**", "tests/**", "**/*.test.*", "**/*.spec.*"],
    "workflows": [".github/workflows/**"],
    "dependencies": ["package.json", "package-lock.json", "npm-shrinkwrap.json", "**/package.json", "**/package-lock.json"],
    "javascript": ["**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "package.json", "package-lock.json"],
    "source": ["src/**", "packages/**"], "automation": [".github/**", "scripts/**", "tools/**"],
    "config": [".editorconfig", ".gitattributes", ".gitignore", "*.json", "*.toml", "*.yaml", "*.yml"],
    "runtime": ["packages/**"], "runtimeExcluded": [".github/**", "docs/**", "README*", "SECURITY*", "CONTRIBUTING*", "tests/**", "**/*.test.*", "**/*.spec.*"],
    "installPackage": ["package.json", "package-lock.json"]
  },
  "commitTextSets": { "breakingMarkers": ["^[^\\n]+!:", "(^|\\n)BREAKING CHANGE:"] },
  "rules": {
    "primaryKind": [
      { "id": "documentation-only", "primaryKind": "documentation", "match": { "type": "all-files", "fileSets": ["docs"] } },
      { "id": "test-only", "primaryKind": "test", "match": { "type": "all-files", "fileSets": ["tests"] } },
      { "id": "workflow-only", "primaryKind": "workflow", "match": { "type": "all-files", "fileSets": ["workflows"] } },
      { "id": "dependency-only", "primaryKind": "build", "match": { "type": "all-files", "fileSets": ["dependencies"] } }
    ],
    "riskFlags": [{ "id": "breaking-commit-marker", "riskFlag": "breaking-change", "match": { "type": "commit-text-any", "commitTextSets": ["breakingMarkers"] } }],
    "facets": [
      { "id": "dependency-files", "facet": "dependencies", "match": { "type": "any-file", "fileSets": ["dependencies"] } },
      { "id": "github-actions-files", "facet": "github_actions", "match": { "type": "any-file", "fileSets": ["workflows"] } },
      { "id": "javascript-files", "facet": "javascript", "match": { "type": "any-file", "fileSets": ["javascript"] } },
      { "id": "configuration-files", "facet": "config", "match": { "type": "any-file", "fileSets": ["config"] } }
    ]
  },
  "areas": [
    { "id": "area-source-files", "area": "area:source", "match": { "type": "any-file", "fileSets": ["source"] } },
    { "id": "area-test-files", "area": "area:test", "match": { "type": "any-file", "fileSets": ["tests"] } },
    { "id": "area-workflow-files", "area": "area:workflow", "match": { "type": "any-file", "fileSets": ["workflows"] } },
    { "id": "area-automation-files", "area": "area:automation", "match": { "type": "any-file", "fileSets": ["automation"] } },
    { "id": "area-documentation-files", "area": "area:docs", "match": { "type": "any-file", "fileSets": ["docs"] } },
    { "id": "area-configuration-files", "area": "area:config", "match": { "type": "any-file", "fileSets": ["config"] } }
  ],
  "ai": { "eligiblePrimaryKinds": ["feature", "bug", "performance", "refactor", "build"], "minimumConfidence": "high" },
  "runtimeRelease": { "includeFileSets": ["runtime"], "excludeFileSets": ["runtimeExcluded"] },
  "installOrPackage": { "fileSets": ["installPackage"] },
  "releaseCategories": []
}
