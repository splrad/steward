{
  "$schema": "../../../schema/release-profile.schema.json",
  "schemaVersion": 2,
  "name": "layerscape",
  "repository": {
    "id": 1187527897,
    "fullName": "splrad/LayerScape"
  },
  "release": {
    "draftDuringUpload": true,
    "prerelease": false,
    "makeLatest": true,
    "requireImmutablePolicy": true
  },
  "releaseNotes": {
    "profile": "common-v3",
    "fragmentDirectory": ".release-notes/fragments",
    "candidateChanges": {
      "required": [
        "src/**",
        "tools/Publish-ReleaseAssets.ps1",
        "Directory.Build.props",
        "chore/Fonts.zip",
        "README.md",
        "docs/user/**"
      ],
      "reviewRequired": [
        ".github/workflows/release.yml",
        ".github/workflows/publish*.yml",
        "Directory.Packages.props",
        "global.json",
        "tools/build/**"
      ],
      "ignored": [
        ".github/**",
        ".local/**",
        ".agents/**",
        ".codex/**",
        ".claude/**",
        ".vscode/**",
        "docs/internal/**",
        "tests/**",
        "VERSION",
        "Version.props"
      ],
      "defaultDisposition": "review-required"
    },
    "personalization": {
      "enabled": false,
      "sections": []
    }
  }
}
