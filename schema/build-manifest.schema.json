{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "fullName", "buildId", "profile", "targetSha", "policySha", "version", "inputsSha256", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "fullName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "buildId": { "$ref": "#/$defs/id" },
    "profile": { "enum": ["dotnet-assets-v1", "node-package-v1", "oci-image-v1", "custom-adapter-v1"] },
    "targetSha": { "$ref": "#/$defs/commit" },
    "policySha": { "$ref": "#/$defs/commit" },
    "version": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }] },
    "inputsSha256": { "$ref": "#/$defs/digest" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "oneOf": [{ "$ref": "#/$defs/file" }, { "$ref": "#/$defs/image" }] } }
  },
  "allOf": [{
    "if": { "properties": { "profile": { "const": "oci-image-v1" } } },
    "then": { "properties": { "artifacts": { "items": { "$ref": "#/$defs/image" } } } },
    "else": { "properties": { "artifacts": { "items": { "$ref": "#/$defs/file" } } } }
  }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 40, "maxLength": 40 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64 },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "file", "mediaType", "size", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "file" },
        "file": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "reference", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "oci-image" },
        "reference": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[a-z0-9_][a-z0-9_.-]{0,127})?@sha256:[0-9a-f]{64}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71 }
      }
    }
  }
}
