{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/release-notes-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "migrationId",
    "repositoryId",
    "previousRelease",
    "boundarySha",
    "expiresAfterTag",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "migrationId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{8,64}$"
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previousRelease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "sha"
          ],
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      ]
    },
    "boundarySha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expiresAfterTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pullNumber",
          "mergeSha",
          "fragment"
        ],
        "properties": {
          "pullNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mergeSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "fragment": {
            "$ref": "#/$defs/fragment"
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "fragment",
        "classification"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "fragment": {
          "$ref": "#/$defs/fragment"
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaryKind",
            "riskFlags"
          ],
          "properties": {
            "primaryKind": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]"
              }
            },
            "riskFlags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fragment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "entries"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "const": "documented"
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/fragment/$defs/entry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "status",
            "reason"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "status": {
              "const": "not-user-facing"
            },
            "reason": {
              "$ref": "#/$defs/fragment/$defs/text"
            }
          }
        }
      ],
      "$defs": {
        "text": {
          "type": "string",
          "minLength": 10,
          "pattern": "^\\s*\\S[\\s\\S]{8,238}\\S\\s*$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]"
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change",
            "userImpact",
            "actionRequired"
          ],
          "properties": {
            "change": {
              "$ref": "#/$defs/fragment/$defs/text"
            },
            "userImpact": {
              "$ref": "#/$defs/fragment/$defs/text"
            },
            "actionRequired": {
              "type": "boolean"
            },
            "action": {
              "type": "string",
              "minLength": 5,
              "pattern": "^\\s*\\S[\\s\\S]{3,238}\\S\\s*$",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\ud800-\\udfff]"
              }
            }
          },
          "if": {
            "properties": {
              "actionRequired": {
                "const": true
              }
            },
            "required": [
              "actionRequired"
            ]
          },
          "then": {
            "properties": {
              "action": {}
            },
            "required": [
              "action"
            ]
          },
          "else": {
            "not": {
              "properties": {
                "action": {}
              },
              "required": [
                "action"
              ]
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "previousRelease": {
        "type": "null"
      }
    },
    "required": [
      "previousRelease"
    ]
  },
  "then": {
    "properties": {
      "root": {}
    },
    "required": [
      "root"
    ]
  },
  "else": {
    "not": {
      "properties": {
        "root": {}
      },
      "required": [
        "root"
      ]
    }
  }
}
