{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/release-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "repository",
    "release",
    "releaseNotes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fullName"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "fullName": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftDuringUpload",
        "prerelease",
        "makeLatest",
        "requireImmutablePolicy"
      ],
      "properties": {
        "draftDuringUpload": {
          "const": true
        },
        "prerelease": {
          "const": false
        },
        "makeLatest": {
          "const": true
        },
        "requireImmutablePolicy": {
          "const": true
        }
      }
    },
    "releaseNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "personalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "sections"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "slot",
                  "title",
                  "items"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "type": {
                    "enum": [
                      "asset-table",
                      "bullet-list"
                    ]
                  },
                  "slot": {
                    "enum": [
                      "beforeActions",
                      "afterChanges"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true,
                    "minItems": 1,
                    "maxItems": 64
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "asset-table"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "slot": {
                          "const": "beforeActions"
                        },
                        "items": {
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                          },
                          "description": "冻结构建清单的逻辑资产 ID；必须唯一对应一个文件。",
                          "type": "array"
                        }
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 16
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "sections": {
                    "minItems": 1,
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "sections": {
                    "maxItems": 0,
                    "type": "array"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
