{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/release-profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "name", "repository", "trigger", "runner", "version", "build", "assets", "releaseNotes", "release"],
  "properties": {
    "$schema": { "type": "string" }, "schemaVersion": { "const": 1 }, "name": { "type": "string" },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "fullName", "defaultBranch"], "properties": { "id": { "type": "integer", "minimum": 1 }, "fullName": { "type": "string" }, "defaultBranch": { "type": "string" } } },
    "trigger": { "type": "object", "additionalProperties": false, "required": ["event", "merged", "changedFiles"], "properties": { "event": { "const": "pull_request.closed" }, "merged": { "const": true }, "changedFiles": { "$ref": "#/$defs/strings" } } },
    "runner": { "type": "object", "additionalProperties": false, "required": ["label", "timeoutMinutes"], "properties": { "label": { "const": "windows-latest" }, "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 60 } } },
    "version": { "type": "object", "additionalProperties": false, "required": ["file", "displayElement", "displayPattern", "buildElement", "buildPattern", "tagTemplate", "titleTemplate"], "properties": { "file": { "type": "string" }, "displayElement": { "type": "string" }, "displayPattern": { "type": "string" }, "buildElement": { "type": "string" }, "buildPattern": { "type": "string" }, "tagTemplate": { "type": "string" }, "titleTemplate": { "type": "string" } } },
    "build": { "$ref": "#/$defs/build" },
    "assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/asset" } },
    "releaseNotes": { "type": "object", "additionalProperties": false, "required": ["classificationProfile", "excludedLabels", "previousRelease", "pullRequestOrder", "emptyRuntimeText", "downloadText", "upgradeItems"], "properties": { "classificationProfile": { "type": "string" }, "excludedLabels": { "$ref": "#/$defs/strings" }, "previousRelease": { "const": "latest-published-first-parent-ancestor" }, "pullRequestOrder": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "const": "mergedAtAscending" }, { "const": "numberAscending" }], "items": false }, "emptyRuntimeText": { "type": "string" }, "downloadText": { "type": "string" }, "upgradeItems": { "$ref": "#/$defs/strings" } } },
    "release": { "type": "object", "additionalProperties": false, "required": ["draftDuringUpload", "prerelease", "makeLatest", "requireImmutablePolicy"], "properties": { "draftDuringUpload": { "const": true }, "prerelease": { "const": false }, "makeLatest": { "const": true }, "requireImmutablePolicy": { "const": true } } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "project": { "type": "object", "additionalProperties": false, "required": ["path", "framework"], "properties": { "path": { "type": "string" }, "framework": { "type": "string" } } },
    "deployer": { "type": "object", "additionalProperties": false, "required": ["path", "framework", "runtime", "selfContained", "singleFile"], "properties": { "path": { "type": "string" }, "framework": { "type": "string" }, "runtime": { "type": "string" }, "selfContained": { "const": true }, "singleFile": { "const": true } } },
    "build": { "type": "object", "additionalProperties": false, "required": ["sdkVersion", "sdkRollForward", "shell", "command", "projects", "deployer"], "properties": { "sdkVersion": { "type": "string" }, "sdkRollForward": { "type": "string" }, "shell": { "const": "pwsh" }, "command": { "type": "string" }, "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } }, "deployer": { "$ref": "#/$defs/deployer" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["nameTemplate", "pathTemplate", "contentType"], "properties": { "nameTemplate": { "type": "string" }, "pathTemplate": { "type": "string" }, "contentType": { "enum": ["application/x-msdownload", "application/zip"] } } }
  }
}
