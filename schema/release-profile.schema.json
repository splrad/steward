{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/release-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "repository",
    "release",
    "releaseNotes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fullName"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "fullName": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftDuringUpload",
        "prerelease",
        "makeLatest",
        "requireImmutablePolicy"
      ],
      "properties": {
        "draftDuringUpload": {
          "const": true
        },
        "prerelease": {
          "const": false
        },
        "makeLatest": {
          "const": true
        },
        "requireImmutablePolicy": {
          "const": true
        }
      }
    },
    "releaseNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "fragmentDirectory",
        "candidateChanges"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fragmentDirectory": {
          "type": "string",
          "minLength": 1
        },
        "candidateChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reviewRequired",
            "ignored",
            "defaultDisposition"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 0
            },
            "reviewRequired": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 0
            },
            "ignored": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 0
            },
            "defaultDisposition": {
              "const": "review-required"
            }
          }
        },
        "personalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "sections"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "type",
                  "slot",
                  "title",
                  "items"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "type": {
                    "enum": [
                      "asset-table",
                      "bullet-list"
                    ]
                  },
                  "slot": {
                    "enum": [
                      "beforeActions",
                      "afterChanges"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  }
                }
              },
              "uniqueItems": true,
              "minItems": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "sections": {
                    "minItems": 1,
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "sections": {
                    "maxItems": 0,
                    "type": "array"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
