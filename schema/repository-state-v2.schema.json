{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splrad.dev/schema/repository-state-v2.schema.json",
  "title": "Historical repository state v2, read-only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "defaultBranch",
    "revision",
    "lastObservedDefaultSha",
    "lastCompletedCycleId",
    "activeCycleId",
    "candidate",
    "nextCheckAt",
    "lastProgressAt",
    "lastErrorCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "defaultBranch": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastObservedDefaultSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastCompletedCycleId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^pr-[1-9][0-9]*-[a-f0-9]{40}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeCycleId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^pr-[1-9][0-9]*-[a-f0-9]{40}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prNumber",
            "branch",
            "baseSha",
            "generatedSnapshotPath",
            "publishedHead",
            "editingAckHead",
            "statusCommentId",
            "contentGenerationDigest",
            "adoptionOverride",
            "observedLabelEventIds",
            "pendingWrite"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "prNumber": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "baseSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
            },
            "generatedSnapshotPath": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:cycles|generated|content|evidence)/[A-Za-z0-9_./-]+$(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publishedHead": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "editingAckHead": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "statusCommentId": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentGenerationDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "adoptionOverride": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "humanHead",
                    "generatedBase",
                    "evidencePath"
                  ],
                  "properties": {
                    "kind": {
                      "const": "legacy-candidate"
                    },
                    "humanHead": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                    },
                    "generatedBase": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                    },
                    "evidencePath": {
                      "type": "string",
                      "pattern": "^generated/[a-f0-9]{64}/adoption.json$(?![\\s\\S])"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "eventId",
                    "actorId",
                    "createdAt",
                    "sourceSha",
                    "evidencePath"
                  ],
                  "properties": {
                    "eventId": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "actorId": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "createdAt": {
                      "type": "string",
                      "pattern": "Z$(?![\\s\\S])",
                      "format": "date-time"
                    },
                    "sourceSha": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                    },
                    "evidencePath": {
                      "type": "string",
                      "pattern": "^(?:cycles|generated|content|evidence)/[A-Za-z0-9_./-]+$(?![\\s\\S])"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedLabelEventIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "pendingWrite": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "expectedHead",
                    "proposedCommit",
                    "newGeneratedSnapshotPath",
                    "newGeneratedDigest",
                    "operationKey",
                    "observedAt"
                  ],
                  "properties": {
                    "expectedHead": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                    },
                    "proposedCommit": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
                    },
                    "newGeneratedSnapshotPath": {
                      "type": "string",
                      "pattern": "^(?:cycles|generated|content|evidence)/[A-Za-z0-9_./-]+$(?![\\s\\S])"
                    },
                    "newGeneratedDigest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                    },
                    "operationKey": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                    },
                    "observedAt": {
                      "type": "string",
                      "pattern": "Z$(?![\\s\\S])",
                      "format": "date-time"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCheckAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "Z$(?![\\s\\S])",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastProgressAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "Z$(?![\\s\\S])",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastErrorCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
