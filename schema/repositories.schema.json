{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/repositories.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "organization",
    "defaults",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 5
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "const": 302208797
        },
        "login": {
          "const": "splrad"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public",
        "private"
      ],
      "properties": {
        "public": {
          "$ref": "#/$defs/defaultConfig"
        },
        "private": {
          "$ref": "#/$defs/defaultConfig"
        }
      }
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repositoryConfig"
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "workflowPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"
      },
      "uniqueItems": true
    },
    "reviewGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "lifecycle",
        "owner",
        "exception",
        "lastVerifiedAt",
        "nextReviewAt"
      ],
      "properties": {
        "scope": {
          "enum": [
            "full",
            "policy-only",
            "excluded"
          ]
        },
        "lifecycle": {
          "enum": [
            "discovered",
            "repository-ready",
            "external-control-ready",
            "operational"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^splrad/[a-z0-9-]+$"
        },
        "exception": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "reason",
            "approvedBy",
            "reviewAt"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "approvedBy": {
              "type": "string",
              "minLength": 1
            },
            "reviewAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "nextReviewAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "excluded"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "exception": {
                "type": "object"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "exception": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "policy-only"
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "lifecycle": {
                "enum": [
                  "discovered",
                  "repository-ready"
                ]
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "labelDefinitionMode",
        "labelAssignmentMode"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "labelDefinitionMode": {
          "enum": [
            "observe",
            "enforce"
          ]
        },
        "labelAssignmentMode": {
          "enum": [
            "observe",
            "enforce"
          ]
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "npm",
            "nuget",
            "pypi",
            "oci-image",
            "oci-artifact",
            "helm",
            "winget"
          ]
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "authMode": {
          "enum": [
            "oidc",
            "github-token",
            "owner-fork"
          ]
        },
        "distTagStable": {
          "const": "latest"
        },
        "distTagPrerelease": {
          "const": "next"
        },
        "nugetUser": {
          "type": "string",
          "minLength": 1
        },
        "artifactType": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^linux/(amd64|arm64)$"
          }
        },
        "packageIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "forkRepository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/winget-pkgs$"
        }
      },
      "required": [
        "enabled",
        "kind",
        "destination",
        "packageName",
        "visibility",
        "environment",
        "authMode"
      ]
    },
    "releaseUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "adoptedAfterTag": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adoptedFromSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/channel"
          }
        }
      },
      "required": [
        "enabled",
        "adoptedAfterTag",
        "adoptedFromSha",
        "channels"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "units": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/releaseUnit"
          }
        }
      },
      "required": [
        "enabled",
        "units"
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managedSync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "policySha": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "policySha"
          ]
        },
        "dependencyUpdates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "managedSync",
        "dependencyUpdates"
      ]
    },
    "defaultConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed",
        "pullRequestTemplate",
        "reviewInstructionsProfile",
        "classification",
        "validationProfile",
        "allowedWorkflowPaths",
        "automation",
        "release",
        "pages",
        "revokedPolicyShas"
      ],
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "pullRequestTemplate": {
          "enum": [
            "organization-default",
            "organization-provider"
          ]
        },
        "reviewInstructionsProfile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "validationProfile": {
          "type": "string"
        },
        "allowedWorkflowPaths": {
          "$ref": "#/$defs/workflowPaths"
        },
        "copilotReviewTrigger": {
          "type": "string",
          "enum": [
            "native"
          ],
          "default": "native"
        },
        "automation": {
          "$ref": "#/$defs/automation"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "revokedPolicyShas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "repositoryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed",
        "fullName",
        "pullRequestTemplate",
        "reviewInstructionsProfile",
        "reviewGovernance",
        "classification",
        "validationProfile",
        "allowedWorkflowPaths",
        "automation",
        "release",
        "pages",
        "revokedPolicyShas",
        "repositoryId",
        "defaultBranch"
      ],
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "fullName": {
          "type": "string",
          "pattern": "^splrad/[^/]+$"
        },
        "pullRequestTemplate": {
          "enum": [
            "organization-default",
            "organization-provider"
          ]
        },
        "reviewInstructionsProfile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "reviewGovernance": {
          "$ref": "#/$defs/reviewGovernance"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "validationProfile": {
          "type": "string"
        },
        "allowedWorkflowPaths": {
          "$ref": "#/$defs/workflowPaths"
        },
        "copilotReviewTrigger": {
          "type": "string",
          "enum": [
            "native"
          ]
        },
        "automation": {
          "$ref": "#/$defs/automation"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "revokedPolicyShas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1
        },
        "defaultBranch": {
          "const": "main"
        }
      }
    }
  }
}
