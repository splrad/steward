{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/splrad/steward/schema/repositories.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "organization", "defaults", "repositories"],
  "properties": {
    "$schema": { "type": "string" }, "schemaVersion": { "const": 2 },
    "organization": { "type": "object", "additionalProperties": false, "required": ["id", "login"], "properties": { "id": { "const": 302208797 }, "login": { "const": "splrad" } } },
    "defaults": { "type": "object", "additionalProperties": false, "required": ["public", "private"], "properties": { "public": { "$ref": "#/$defs/defaultConfig" }, "private": { "$ref": "#/$defs/defaultConfig" } } },
    "repositories": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "$ref": "#/$defs/repositoryConfig" } }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "canary": { "type": "object", "additionalProperties": false, "required": ["repositoryId", "pullRequestNumber", "headSha", "sourceRepositoryId", "sourceRef"], "properties": { "repositoryId": { "type": "integer", "minimum": 1 }, "pullRequestNumber": { "type": "integer", "minimum": 1 }, "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sourceRepositoryId": { "type": "integer", "minimum": 1 }, "sourceRef": { "type": "string", "pattern": "^refs/heads/.+" } } },
    "classification": { "type": "object", "additionalProperties": false, "required": ["profile", "labelDefinitionMode", "labelAssignmentMode", "ai"], "properties": { "profile": { "type": "string", "minLength": 1 }, "labelDefinitionMode": { "enum": ["observe", "enforce"] }, "labelAssignmentMode": { "enum": ["observe", "enforce"] }, "ai": { "type": "object", "additionalProperties": false, "required": ["mode", "adoptedPrimaryKinds", "canaries"], "properties": { "mode": { "enum": ["shadow", "draft-canary", "active"] }, "adoptedPrimaryKinds": { "$ref": "#/$defs/strings" }, "canaries": { "type": "array", "items": { "$ref": "#/$defs/canary" } } } } } },
    "defaultConfig": { "type": "object", "additionalProperties": false, "required": ["managed", "prAutomation", "pullRequestTemplate", "copilotInstructionsProfile", "classification", "validationProfile", "allowedWorkflowPaths", "releaseProfile"], "properties": { "managed": { "type": "boolean" }, "prAutomation": { "type": "boolean" }, "pullRequestTemplate": { "enum": ["organization-default", "organization-provider"] }, "copilotInstructionsProfile": { "enum": ["common", "layerscape"] }, "classification": { "$ref": "#/$defs/classification" }, "validationProfile": { "type": "string" }, "allowedWorkflowPaths": { "$ref": "#/$defs/strings" }, "releaseProfile": { "type": ["string", "null"] } } },
    "repositoryConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["managed", "fullName", "prAutomation", "pullRequestTemplate", "copilotInstructionsProfile", "classification", "validationProfile", "allowedWorkflowPaths", "releaseProfile"],
      "properties": {
        "managed": { "type": "boolean" }, "fullName": { "type": "string", "pattern": "^splrad/[^/]+$" },
        "prAutomation": { "type": "boolean" }, "pullRequestTemplate": { "enum": ["organization-default", "organization-provider"] },
        "copilotInstructionsProfile": { "enum": ["common", "layerscape"] }, "classification": { "$ref": "#/$defs/classification" },
        "validationProfile": { "type": "string" }, "allowedWorkflowPaths": { "$ref": "#/$defs/strings" }, "releaseProfile": { "type": ["string", "null"] }
      }
    }
  }
}
