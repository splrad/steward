{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "fullName",
    "unitId",
    "version",
    "packageVersion",
    "tag",
    "sourceSha",
    "policySha",
    "descriptorSha256",
    "templateSha256",
    "runId",
    "attempt",
    "toolLocks",
    "producers",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fullName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "unitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+([+-][A-Za-z0-9.+-]+)?$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "policySha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "descriptorSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "templateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "toolLocks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "buildId",
          "jobId",
          "attempt",
          "artifactId"
        ],
        "properties": {
          "buildId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "jobId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "artifactId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "id",
          "kind",
          "mediaType",
          "platform",
          "architecture"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "executable",
              "archive",
              "installer",
              "npm",
              "nuget",
              "python-wheel",
              "python-sdist",
              "jar",
              "crate",
              "oci-image",
              "helm",
              "data"
            ]
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "platform": {
            "enum": [
              "ubuntu",
              "windows",
              "macos",
              "any",
              "source"
            ]
          },
          "architecture": {
            "enum": [
              "x64",
              "arm64",
              "any"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 996
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true,
      "maxItems": 2
    }
  }
}
