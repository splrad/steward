{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splrad.dev/schema/release-asset-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "cycleId", "deliveryConfigSha", "units"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "cycleId": { "type": "string", "pattern": "^pr-[1-9][0-9]*-[a-f0-9]{40}$" },
    "deliveryConfigSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "artifactIds", "metadata"],
        "properties": {
          "unitId": { "$ref": "#/$defs/id" },
          "artifactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "metadata": { "type": "array", "uniqueItems": true, "items": { "enum": ["sbom.spdx.json", "release-notes.md", "artifact-manifest.json", "SHA256SUMS"] } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
  }
}
