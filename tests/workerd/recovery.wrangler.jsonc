{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "steward-recovery-workerd-test",
  "main": "./recovery-fixture.ts",
  "compatibility_date": "2026-07-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "DELIVERY_RECOVERY_LEDGER",
        "class_name": "DeliveryRecoveryLedger"
      },
      {
        "name": "PR_COORDINATOR",
        "class_name": "PullRequestCoordinator"
      },
      {
        "name": "REPOSITORY_FANOUT_COORDINATOR",
        "class_name": "RepositoryFanoutCoordinator"
      }
    ]
  },
  "exports": {
    "DeliveryRecoveryLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PullRequestCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RepositoryFanoutCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
