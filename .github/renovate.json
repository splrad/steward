{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "ignoreScripts": true,
  "timezone": "Asia/Bangkok",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "ignoreUnstable": true,
  "minimumReleaseAge": null,
  "schedule": [
    "at any time"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/^templates/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/**",
        "action.yml",
        "action.yaml",
        "templates/**",
        ".github/actions/**"
      ],
      "matchDepTypes": [
        "uses-with",
        "container",
        "service",
        "docker",
        "github-runner"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "splrad/steward"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "node"
      ],
      "versioning": "semver",
      "ignoreUnstable": true
    },
    {
      "matchDatasources": [
        "custom.github-rest-api"
      ],
      "prBodyNotes": [
        "GitHub REST API 升级须按官方 breaking changes 同步适配全部调用端、测试和构建产物；通过既有检查后再采用。"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/actions-lock-version\\.txt$/"
      ],
      "matchStrings": [
        "(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "github/gh-actions-lock",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/private-dependency-security\\.json$/"
      ],
      "matchStrings": [
        "\"osvImage\":\\s*\"ghcr.io/google/osv-scanner-action:(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/google/osv-scanner-action",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/github-api\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>\\d{4}-\\d{2}-\\d{2})\""
      ],
      "depNameTemplate": "github-rest-api",
      "datasourceTemplate": "custom.github-rest-api",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "enabledManagers": [
    "mise",
    "github-actions",
    "custom.regex"
  ],
  "ignorePaths": [
    ".github/workflows/pr-title.yml",
    ".github/workflows/pr-labeler.yml",
    ".github/labeler.yml"
  ],
  "prHeader": "本 PR 包含以下依赖更新：",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change"
  ],
  "prBodyHeadingDefinitions": {
    "Package": "组件",
    "Type": "依赖类别",
    "Update": "更新类型",
    "Change": "版本变化"
  },
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "prFooter": "本 PR 由 [Renovate](https://github.com/renovatebot/renovate) 自动生成。",
  "customDatasources": {
    "github-rest-api": {
      "defaultRegistryUrlTemplate": "https://api.github.com/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $map($, function($v) { {\"version\": $v, \"isStable\": true} }), \"homepage\": \"https://docs.github.com/en/rest/about-the-rest-api/api-versions\", \"changelogUrl\": \"https://docs.github.com/en/rest/overview/breaking-changes\"}"
      ]
    }
  }
}
