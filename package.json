{
  "name": "@splrad/steward",
  "private": true,
  "description": "Central repository automation for SPLRAD projects.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": "24.14.1" },
  "packageManager": "npm@11.11.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "node scripts/build-runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify": "npm run test && npm run typecheck && npm run verify:config && npm run verify:dist && npm run verify:workflows"
  },
  "dependencies": {
    "@github/copilot": "1.0.79",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.8",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260815.1",
    "@types/node": "26.2.0",
    "@vercel/ncc": "0.45.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
