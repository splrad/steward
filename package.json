{
  "name": "@splrad/steward",
  "private": true,
  "description": "Central repository automation for SPLRAD projects.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/settings-events"
  ],
  "scripts": {
    "build": "node scripts/build-runner.mjs",
    "test": "uv sync --project tools/template --frozen --only-group release-inspection --inexact --no-build && npm run test:pages && npm run test:private-dependencies && npm run test:settings-events && npm run test:controller-source && vitest run",
    "test:controller-source": "node --test scripts/controller-source.test.mjs",
    "test:pages": "node --test scripts/test/select-pages-source.test.mjs scripts/test/pages-wiring.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit && node scripts/verify-source-boundaries.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify": "npm run test && npm run typecheck && npm run verify:config && npm run verify:dist && npm run verify:workflows",
    "test:template": "uv run --project tools/template --frozen python -m unittest discover -s tools/template -p test_*.py -v",
    "test:private-dependencies": "node --test scripts/test/private-dependencies.test.mjs scripts/test/private-lifecycle.test.mjs",
    "test:settings-events": "npm run test --workspace=@splrad/settings-events"
  },
  "dependencies": {
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "minimatch": "10.2.6",
    "mustache": "4.2.0",
    "remark-parse": "11.0.0",
    "semver": "7.8.5",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.5",
    "@vercel/ncc": "0.45.0",
    "release-please": "17.11.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
