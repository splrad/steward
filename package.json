{
  "name": "@splrad/steward",
  "private": true,
  "description": "Central repository automation for SPLRAD projects.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/settings-events"
  ],
  "scripts": {
    "build": "node scripts/build-runner.mjs",
    "test": "node scripts/steward-tests.mjs",
    "test:source-controller": "node scripts/steward-tests.mjs --controller-only",
    "test:quality-language": "node scripts/steward-tests.mjs --quality-language",
    "test:configuration": "node --test scripts/test/configuration-authority.test.mjs scripts/test/repository-registration.test.mjs scripts/test/security-policy.test.mjs",
    "test:bounded-release": "node --test scripts/test/bounded-release-entry.test.mjs scripts/test/release-cycle-event.test.mjs scripts/test/official-candidate-event.test.mjs scripts/test/official-release.test.mjs scripts/test/release-pause-policy.test.mjs",
    "test:controller-source": "node --test scripts/controller-source.test.mjs scripts/validator-revalidation.test.mjs scripts/controller-pin-policy.test.mjs scripts/controller-version.test.mjs",
    "test:pages": "node --test scripts/test/select-pages-source.test.mjs scripts/test/pages-wiring.test.mjs scripts/test/pages-completion-native.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit && node scripts/verify-source-boundaries.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify": "npm run test && npm run typecheck && npm run verify:config && npm run verify:dist && npm run verify:workflows",
    "test:template": "uv run --project tools/template --frozen python -m unittest discover -s tools/template -p test_*.py -v",
    "test:private-dependencies": "node --test scripts/test/private-dependencies.test.mjs scripts/test/private-lifecycle.test.mjs",
    "test:settings-events": "npm run test --workspace=@splrad/settings-events"
  },
  "dependencies": {
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "minimatch": "11.0.9",
    "mustache": "4.2.0",
    "parse5": "8.1.1",
    "parse5-sax-parser": "8.0.1",
    "remark-parse": "11.0.0",
    "semver": "7.8.6",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "es-module-lexer": "2.3.2",
    "release-please": "17.11.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
