{
  "name": "@splrad/steward",
  "private": true,
  "description": "Central repository automation for SPLRAD projects.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify": "npm run test && npm run typecheck && npm run verify:config && npm run verify:dist && npm run verify:workflows"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.12",
    "minimatch": "10.2.6",
    "mustache": "4.2.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.5",
    "@vercel/ncc": "0.45.0",
    "release-please": "17.6.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
